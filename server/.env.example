# Neo4j Aura credentials stay on the API server and are never returned to the browser.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-aura-password
NEO4J_DATABASE=neo4j
SESSION_SECRET=replace-with-a-long-random-secret-in-production
SECURE_SESSION_COOKIE=false

# GitHub OAuth App credentials. The app requests only public profile identity (read:user).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8765/api/auth/github/callback
FRONTEND_URL=http://127.0.0.1:5173/

# In production, enable secure cookies and set the exact public app origin.
SESSION_COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
